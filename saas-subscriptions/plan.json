        "step": 1,
        "start": 1,
        "prefix": "",
        "padding": 0
       },
       "if": "DEFAULT"
      }
     ],
     "nullable": false,
     "unique": true
    },
    "reason": {
     "data_type": "string",
     "rules": [
      {
       "generate_via": "categorical",
       "parameters": {
        "distribution": [
         {
          "percentage": 28.0,
          "value": "price"
         },
         {
          "percentage": 16.0,
          "value": "missing_feature"
         },
         {
          "percentage": 20.0,
          "value": "switched_tool"
         },
         {
          "percentage": 24.0,
          "value": "low_usage"
         },
         {
          "percentage": 5.0,
          "value": "company_closed"
         },
         {
          "percentage": 7.0,
          "value": "support"
         }
        ]
       },
       "if": "DEFAULT"
      }
     ],
     "nullable": false
    },
    "churned_on": {
     "data_type": "date",
     "rules": [
      {
       "generate_via": "lookup",
       "if": "DEFAULT",
       "parameters": {
        "path": "@anchor.ended_on"
       }
      }
     ],
     "date_after": [
      "subscription_id.started_on",
      "@anchor.started_on",
      "@anchor.account_id.signup_date"
     ],
     "nullable": false
    },
    "feedback_score": {
     "data_type": "integer",
     "rules": [
      {
       "generate_via": "range",
       "parameters": {
        "context_columns": [
         "reason"
        ],
        "distribution": [
         {
          "percentage": 100,
          "max": 5,
          "min": 1
         }
        ]
       },
       "if": "{reason} == 'support' or {reason} == 'price'"
      },
      {
       "generate_via": "range",
       "parameters": {
        "context_columns": [
         "reason"
        ],
        "distribution": [
         {
          "percentage": 100,
          "max": 10,
          "min": 5
         }
        ]
       },
       "if": "DEFAULT"
      }
     ],
     "nullable": true
    }
   },
