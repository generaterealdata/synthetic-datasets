     "_fk_source": "inline",
     "rules": [
      {
       "generate_via": "lookup",
       "if": "DEFAULT",
       "parameters": {
        "path": "@anchor.subscription_id"
       }
      }
     ],
     "nullable": false
    },
    "churn_id": {
     "data_type": "integer",
