 "dataset_type": "relational",
 "tables": {
  "employees": {
   "columns": {
    "last_name": {
     "data_type": "string",
     "rules": [
      {
       "generate_via": "primitive",
       "if": "DEFAULT",
       "parameters": {
        "primitive_type": "last_name"
       }
      }
     ],
     "nullable": false
    },
    "first_name": {
     "data_type": "string",
     "rules": [
      {
       "generate_via": "primitive",
       "if": "DEFAULT",
       "parameters": {
        "primitive_type": "first_name"
       }
      }
     ],
     "nullable": false
    },
    "hire_date": {
     "data_type": "date",
     "rules": [
      {
       "generate_via": "date_range",
       "if": "random_int(1, 10000) <= 2200",
       "parameters": {
        "start_date": "2015-01-01",
        "end_date": "2018-12-31",
        "include_time": false
       }
      },
      {
       "generate_via": "date_range",
       "if": "random_int(1, 10000) <= 3333",
       "parameters": {
        "start_date": "2019-01-01",
        "end_date": "2021-12-31",
        "include_time": false
       }
      },
      {
       "generate_via": "date_range",
       "if": "random_int(1, 10000) <= 6154",
       "parameters": {
        "start_date": "2022-01-01",
        "end_date": "2024-12-31",
        "include_time": false
       }
      },
      {
       "generate_via": "date_range",
       "if": "DEFAULT",
       "parameters": {
        "start_date": "2025-01-01",
        "end_date": "2026-08-31",
        "include_time": false
       }
      }
     ],
     "nullable": false
    },
    "email": {
     "data_type": "string",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "DEFAULT",
       "parameters": {
        "equation": "lowercase(concat(replace({first_name}, ' ', ''), '.', replace({last_name}, ' ', ''), {employee_id}, '@corp.example.com'))"
       }
      }
     ],
     "nullable": false,
     "unique": true
    },
    "job_title": {
     "data_type": "string",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "{job_level} == 1",
       "parameters": {
        "equation": "concat('Associate, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "{job_level} == 2",
       "parameters": {
        "equation": "concat('Specialist, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "{job_level} == 3",
       "parameters": {
        "equation": "concat('Senior Specialist, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "{job_level} == 4",
       "parameters": {
        "equation": "concat('Lead, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "{job_level} == 5",
       "parameters": {
        "equation": "concat('Manager, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "{job_level} == 6",
       "parameters": {
        "equation": "concat('Director, ', {department_id.department_name})"
       }
      },
      {
       "generate_via": "calculated",
       "if": "DEFAULT",
       "parameters": {
        "equation": "concat('Vice President, ', {department_id.department_name})"
       }
      }
     ],
     "nullable": false
    },
    "termination_date": {
     "data_type": "date",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "{employment_status} == 'terminated'",
       "parameters": {
        "equation": "min(add_months({hire_date}, random_int(3, 90)), '2026-09-30')"
       }
      },
      {
       "generate_via": "null_injection",
       "if": "DEFAULT",
       "parameters": {
        "base_strategy": "calculated",
        "base_parameters": {
         "equation": "min(add_months({hire_date}, random_int(3, 90)), '2026-09-30')"
        },
        "null_rate": 1.0
       }
      }
     ],
     "date_after": [
      "hire_date"
     ],
     "nullable": true
    },
    "work_mode": {
     "data_type": "string",
