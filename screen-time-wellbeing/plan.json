     "data_type": "string",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "DEFAULT",
       "parameters": {
        "equation": "round(min(14, max(1, if_else({age} < 25, 7.5, if_else({age} < 40, 6, 4.5)) + random_float(-2.5, 2.5))), 1)"
       }
      }
     ]
    },
    "diagnosed_anxiety": {
     "data_type": "string",
     "rules": [
