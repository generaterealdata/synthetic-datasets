         {
          "value": "true",
          "percentage": 5
         },
         {
          "value": "false",
          "percentage": 95
         }
        ]
       }
      },
      {
       "generate_via": "categorical",
       "if": "DEFAULT",
       "parameters": {
        "distribution": [
         {
          "value": "true",
          "percentage": 48
         },
         {
          "value": "false",
