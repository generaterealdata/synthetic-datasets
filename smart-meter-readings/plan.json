       "if": "{premise_id.has_ev} == True",
       "parameters": {
        "distribution": [
         {
          "value": "TOU-EV",
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "categorical",
       "if": "DEFAULT",
       "parameters": {
        "distribution": [
         {
          "value": "TOU-STD",
          "percentage": 100
         }
        ]
       }
