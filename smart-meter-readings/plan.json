  "readings": {
   "entity_count": 100,
   "dataset_type": "time_series",
   "columns": {
    "export_kwh": {
     "data_type": "float",
     "scope": "event",
     "rules": [
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_solar} == True and substring({interval_start}, 11, 2) >= '11' and substring({interval_start}, 11, 2) < '14'",
       "parameters": {
        "distribution": [
         {
          "min": 0.45,
          "max": 0.8,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_solar} == True and substring({interval_start}, 11, 2) >= '09' and substring({interval_start}, 11, 2) < '16'",
       "parameters": {
        "distribution": [
         {
          "min": 0.2,
          "max": 0.5,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_solar} == True and substring({interval_start}, 11, 2) >= '07' and substring({interval_start}, 11, 2) < '19'",
       "parameters": {
        "distribution": [
         {
          "min": 0.02,
          "max": 0.15,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "DEFAULT",
       "parameters": {
        "distribution": [
         {
          "min": 0.0,
          "max": 0.0,
          "percentage": 100
         }
        ]
       }
      }
     ],
     "nullable": false
    },
    "rate_per_kwh": {
     "data_type": "float",
     "scope": "event",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "DEFAULT",
       "parameters": {
        "equation": "if_else({is_peak}, 0.38, 0.24)"
       }
      }
     ],
     "nullable": false
    },
    "meter_id": {
     "data_type": "integer",
     "references": {
      "table": "meters",
      "column": "meter_id"
     },
     "_fk_source": "inline",
     "scope": "entity",
     "nullable": false,
     "rules": [
      {
       "generate_via": "foreign_key",
       "if": "DEFAULT",
       "parameters": {
        "target_table": "meters",
        "target_column": "meter_id",
        "fk_distribution": "uniform"
       }
      }
     ]
    },
    "import_kwh": {
     "data_type": "float",
     "scope": "event",
     "rules": [
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'small_business' and substring({interval_start}, 11, 2) >= '08' and substring({interval_start}, 11, 2) < '18'",
       "parameters": {
        "distribution": [
         {
          "min": 0.8,
          "max": 1.6,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'small_business' and (substring({interval_start}, 11, 2) == '07' or substring({interval_start}, 11, 2) == '18')",
       "parameters": {
        "distribution": [
         {
          "min": 0.3,
          "max": 0.6,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'small_business'",
       "parameters": {
        "distribution": [
         {
          "min": 0.08,
          "max": 0.18,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_ev} == True and (substring({interval_start}, 11, 2) >= '22' or substring({interval_start}, 11, 2) < '02')",
       "parameters": {
        "distribution": [
         {
          "min": 1.6,
          "max": 2.2,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_solar} == True and substring({interval_start}, 11, 2) >= '10' and substring({interval_start}, 11, 2) < '15'",
       "parameters": {
        "distribution": [
         {
          "min": 0.02,
          "max": 0.1,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.has_solar} == True and substring({interval_start}, 11, 2) >= '08' and substring({interval_start}, 11, 2) < '17'",
       "parameters": {
        "distribution": [
         {
          "min": 0.06,
          "max": 0.2,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'apartment' and substring({interval_start}, 11, 2) < '06'",
       "parameters": {
        "distribution": [
         {
          "min": 0.05,
          "max": 0.1,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'apartment' and substring({interval_start}, 11, 2) < '09'",
       "parameters": {
        "distribution": [
         {
          "min": 0.12,
          "max": 0.3,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'apartment' and substring({interval_start}, 11, 2) < '17'",
       "parameters": {
        "distribution": [
         {
          "min": 0.08,
          "max": 0.18,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'apartment' and substring({interval_start}, 11, 2) < '21'",
       "parameters": {
        "distribution": [
         {
          "min": 0.15,
          "max": 0.4,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "{meter_id.premise_id.premise_type} == 'apartment'",
       "parameters": {
        "distribution": [
         {
          "min": 0.1,
          "max": 0.2,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "substring({interval_start}, 11, 2) < '06'",
       "parameters": {
        "distribution": [
         {
          "min": 0.1,
          "max": 0.2,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "substring({interval_start}, 11, 2) < '09'",
       "parameters": {
        "distribution": [
         {
          "min": 0.25,
          "max": 0.6,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "substring({interval_start}, 11, 2) < '17'",
       "parameters": {
        "distribution": [
         {
          "min": 0.15,
          "max": 0.35,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "substring({interval_start}, 11, 2) < '21'",
       "parameters": {
        "distribution": [
         {
          "min": 0.3,
          "max": 0.8,
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "range",
       "if": "DEFAULT",
       "parameters": {
        "distribution": [
         {
          "min": 0.2,
          "max": 0.4,
          "percentage": 100
         }
        ]
       }
      }
     ],
     "nullable": false
    },
    "reading_id": {
     "data_type": "integer",
     "scope": "event",
     "rules": [
      {
       "generate_via": "sequence",
       "if": "DEFAULT",
       "parameters": {
        "prefix": "",
        "start": 1,
        "step": 1,
        "padding": 0
       }
      }
     ],
     "nullable": false,
     "unique": true
    },
    "cost": {
     "data_type": "float",
     "scope": "event",
     "rules": [
      {
       "generate_via": "calculated",
       "if": "DEFAULT",
       "parameters": {
        "equation": "round({import_kwh} * {rate_per_kwh}, 2)"
       }
      }
     ],
     "nullable": false
    },
    "is_peak": {
     "data_type": "boolean",
     "scope": "event",
     "rules": [
      {
       "generate_via": "categorical",
       "if": "substring({interval_start}, 11, 2) >= '17' and substring({interval_start}, 11, 2) < '21'",
       "parameters": {
        "distribution": [
         {
          "value": "true",
          "percentage": 100
         }
        ]
       }
      },
      {
       "generate_via": "categorical",
       "if": "DEFAULT",
       "parameters": {
        "distribution": [
         {
          "value": "false",
          "percentage": 100
         }
        ]
       }
      }
     ],
     "nullable": false
    },
    "interval_start": {
     "data_type": "date",
     "scope": "event",
     "rules": [
      {
       "generate_via": "time_series_date",
       "if": "DEFAULT",
       "parameters": {
        "start_date": "2026-08-01T00:00:00",
        "frequency": "minutely",
        "interval": 15
       }
      }
     ],
     "date_after": [
      "meter_id.installed_on"
     ],
     "nullable": false
    },
    "voltage_v": {
     "data_type": "float",
     "scope": "event",
     "rules": [
      {
       "generate_via": "random_walk",
       "if": "DEFAULT",
       "parameters": {
        "start_min": 238,
        "start_max": 242,
        "max_step_variance": 0.6,
        "min_clip": 228,
        "max_clip": 252,
        "mean_reversion": 0.2
       }
      }
     ],
     "nullable": false
    }
   },
   "frequency": "minutely",
   "rows_per_entity": 4998,
   "total_rows": 499800,
