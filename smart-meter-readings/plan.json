     },
     "_fk_source": "inline",
     "rules": [
      {
       "generate_via": "foreign_key",
       "if": "DEFAULT",
       "parameters": {
        "target_table": "premises",
        "target_column": "premise_id",
        "fk_distribution": "at_least_one"
       }
      }
